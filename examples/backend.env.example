# Đặt trong môi trường backend của từng dự án, KHÔNG đưa vào Next.js NEXT_PUBLIC_*.
# URL ký phải là domain public chính xác mà trình duyệt upload vào.
S3_PUBLIC_ENDPOINT=https://cdn.dangngochai.io.vn
# Nếu backend cùng Docker network web, dùng nội bộ cho HEAD/GET/DELETE.
# Nếu ở VPS khác, dùng endpoint public qua HTTPS.
S3_INTERNAL_ENDPOINT=http://storage-minio:9000
S3_REGION=us-east-1
S3_BUCKET=example-app-prod
S3_ACCESS_KEY=REPLACE_WITH_DEDICATED_USER_ACCESS_KEY
S3_SECRET_KEY=REPLACE_WITH_DEDICATED_USER_SECRET_KEY
